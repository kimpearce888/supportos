# ==============================================================
# SupportOS environment configuration
# Copy to .env and fill in your own values. NEVER commit .env.
# ==============================================================

# --- Application ---
# Local URL of this application (used for OAuth redirect + links)
LOCAL_APP_URL=http://localhost:3000
# Port the backend listens on
PORT=3000
# Bind address. Keep 127.0.0.1 for a local-only installation.
HOST=127.0.0.1

# --- Help Scout OAuth (create at Your Profile > My Apps in Help Scout) ---
HELPSCOUT_CLIENT_ID=
HELPSCOUT_CLIENT_SECRET=
HELPSCOUT_REDIRECT_URI=http://localhost:3000/oauth/callback

# --- Local AI (LM Studio) ---
LMSTUDIO_BASE_URL=http://127.0.0.1:1234
LMSTUDIO_CHAT_MODEL=
LMSTUDIO_EMBEDDING_MODEL=
LMSTUDIO_TIMEOUT_MS=120000
LMSTUDIO_CONCURRENCY=2

# --- Local vector store (optional) ---
QDRANT_URL=http://127.0.0.1:6333
QDRANT_ENABLED=true

# --- Storage ---
DATABASE_PATH=./data/supportos.db
ATTACHMENTS_PATH=./data/attachments
# Backups directory (packaged desktop builds set this automatically)
# BACKUPS_PATH=./backups

# --- Behaviour ---
# Set to true to run with a simulated Help Scout account (no credentials needed)
LOCAL_DEMO_MODE=false
LOG_LEVEL=info
# Sync interval in minutes for the background poller
SYNC_INTERVAL_MINUTES=5
# Real-time ratings watcher interval in seconds (0 disables; clamped 10-3600)
# RATINGS_REFRESH_SECONDS=30
# Secret for webhook signature verification (set in Help Scout Webhooks app)
HELPSCOUT_WEBHOOK_SECRET=

# --- Docs API (Help Scout Docs live on a separate host with their own key) ---
# Create a Docs API key in Help Scout: Manage > Docs > API Keys
# HELPSCOUT_DOCS_API_KEY=
# HELPSCOUT_DOCS_API_BASE=https://docsapi.helpscout.net
