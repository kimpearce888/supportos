{
  "name": "supportos",
  "version": "2.1.0",
  "description": "SupportOS - local-first AI-powered support operating system for Help Scout",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:all": "vitest run",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:backup": "tsx scripts/backup.ts",
    "db:restore": "tsx scripts/restore.ts",
    "db:seed": "tsx scripts/seed-demo.ts",
    "healthcheck": "tsx scripts/healthcheck.ts",
    "desktop:dev": "npx tauri dev",
    "desktop:build": "npx tauri build",
    "desktop:prepare": "node scripts/build-desktop.mjs",
    "desktop:icon": "python3 scripts/make_icon.py && npx tauri icon src-tauri/app-icon.png -o src-tauri/icons",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "10.1.5",
    "better-sqlite3": "^12.2.0",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "fastify": "^5.3.3",
    "mammoth": "^1.9.0",
    "pdf-parse": "^1.1.1",
    "sanitize-html": "^2.14.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.68.0",
    "@tauri-apps/cli": "^2.12.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/sanitize-html": "^2.13.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.22.0",
    "lucide-react": "^0.479.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.3.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vite": "^6.2.2",
    "vitest": "^3.0.8",
    "zustand": "^5.0.3"
  }
}
